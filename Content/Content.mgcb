
#----------------------------- Global Properties ----------------------------#

/outputDir:bin/$(Platform)
/intermediateDir:obj/$(Platform)
/platform:Windows
/config:
/profile:Reach
/compress:False

#-------------------------------- References --------------------------------#


#---------------------------------- Content ---------------------------------#

#begin Fonts/BLKCHCRY.TTF
/importer:FontImporter
/processor:FontDescriptionProcessor
/processorParam:PremultiplyAlpha=True
/processorParam:TextureFormat=Compressed
/processorParam:Version=3.8.5.1
/build:Fonts/BLKCHCRY.TTF

#begin Fonts/Roboto_Condensed-Bold.ttf
/importer:FontImporter
/processor:FontDescriptionProcessor
/processorParam:PremultiplyAlpha=True
/processorParam:TextureFormat=Compressed
/processorParam:Version=3.8.5.1
/build:Fonts/Roboto_Condensed-Bold.ttf

#begin Fonts/twoforjuannf.regular.ttf
